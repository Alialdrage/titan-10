# Firebase project ID must match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Web App configuration (public values; never put server secrets here).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Upstash Redis REST credentials (server-side secrets only).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-server-side-token

# Existing AI provider secret (server-side only).
OPENROUTER_API_KEY=

# Keep disabled until the Crew service is deployed and all auth/quota settings are verified.
CREW_API_ENABLED=false
CREW_SERVICE_URL=
CREW_API_TOKEN=
